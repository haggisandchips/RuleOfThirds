{
    "manifest_version": 3,

    "name": "Rule of Thirds",
    "version": "1.7",
    "description": "A customisable grid overlay for visualising image composition techniques (primarily the Rule of Thirds).",

    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },

    "background": {
        "service_worker": "service_worker.js"
    },

    "permissions": [
        "scripting",
        "activeTab",
        "storage",
        "contextMenus"
    ],

    "options_page": "options/options.html",

    "action": {
        "default_icon": {
            "19": "icon19-inactive.png",
            "38": "icon38-inactive.png"
        },
        "default_title": "Toggle the grid on or off for this page's images",
        "name": "Rule of Thirds"
    }
}
